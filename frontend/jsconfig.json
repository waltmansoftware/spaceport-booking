{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedSideEffectImports": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "include": ["src"]
}
